{
  "name": "openflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @openflow/web dev",
    "server": "pnpm --filter @openflow/server dev",
    "dev:all": "concurrently -n web,server -c cyan,magenta \"pnpm --filter @openflow/web dev\" \"pnpm --filter @openflow/server dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.4"
  }
}
