{
  "name": "openflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "dev": "pnpm --filter @openflow/web dev",
    "server": "pnpm --filter @openflow/server dev",
    "dev:all": "concurrently -n server,web -c magenta,cyan \"pnpm --filter @openflow/server dev\" \"node scripts/wait-for-port.mjs 8787 && pnpm --filter @openflow/web dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:version": "node scripts/check-version.mjs",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.8.4"
  }
}
